<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme while the process starts. Kingdom Drop is a dark-only
         game, so this is the same in light and dark system modes. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Window theme once the engine is up and behind the Flutter UI. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/kd_background</item>
    </style>
</resources>
