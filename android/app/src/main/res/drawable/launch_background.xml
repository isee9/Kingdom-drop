<?xml version="1.0" encoding="utf-8"?>
<!-- Shown by the OS while the Flutter engine warms up. Painting the app's own
     background colour means launch flows straight into the splash screen with
     no white flash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/kd_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
